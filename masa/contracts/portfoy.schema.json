{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PortfoyResponse",
  "type": "object",
  "required": ["schema_version", "positions_count", "cash_eur", "total_eur", "positions"],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": ["string", "null"] },
    "completed_at": { "type": ["string", "null"] },
    "positions_count": { "type": "integer" },
    "cash_eur": { "type": "number" },
    "total_eur": { "type": "number" },
    "warning": { "type": ["string", "null"] },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["isin", "name", "role", "quantity", "mid_eur", "value_eur", "weight_pct", "quality"],
        "properties": {
          "isin": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "quantity": { "type": "number" },
          "mid_eur": { "type": "number" },
          "value_eur": { "type": "number" },
          "weight_pct": { "type": "number" },
          "quality": { "type": "string" },
          "fifo_price_eur": { "type": ["number", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
